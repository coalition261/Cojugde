# ─────────────────────────────────────────────────────────────
# CoJudge — Next.js service environment
# Copy to .env for local dev:  cp .env.example .env
# On Alternate Clouds: set these in the service's Variables tab, then Rebuild, then Deploy.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 17 (Alternate Clouds template passes this in when linked)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cojudge
# Set to "true" if your Postgres requires TLS (most hosted providers)
DATABASE_SSL=false
# Max DB connections per app instance (use 4 with npm run db:local)
DATABASE_POOL_MAX=10

# Public URL of this app (used in email links). No trailing slash.
APP_URL=http://localhost:3000

# ── AI evidence (Groq) ── https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (confirm live models at https://api.groq.com/openai/v1/models)
GROQ_EVIDENCE_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Tokens per minute your Groq tier allows (free tier: 8000). The prompt is trimmed to fit.
GROQ_TPM_LIMIT=8000
GROQ_MAX_COMPLETION_TOKENS=2200

# ── GitHub ── fine-grained, READ-ONLY token (Public repositories: read). 5,000 req/h vs 60 without.
GITHUB_TOKEN=

# ── YouTube Data API v3 ── Google Cloud console → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=

# ── n8n ── public n8n URL and the shared Header Auth value for its webhooks
N8N_BASE_URL=https://cojudge-flow-app.alternatefutures.ai
N8N_WEBHOOK_KEY=change-me-long-random-string

# Key n8n sends to Next.js in the x-internal-key header (/api/internal/*)
INTERNAL_KEY=change-me-another-long-random-string

# ── Auth ── 32+ random characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=change-me-at-least-32-characters-long-please
# Shared passcode hashes. Generate with:  npm run hash-passcode -- "your-passcode"
JUDGE_PASSCODE_HASH=
ORGANIZER_PASSCODE_HASH=

# ── Event timing (UTC) ──
# Code freeze: 12:45 PM PKT, 17 Oct 2026
FREEZE_AT=2026-10-17T07:45:00Z
# Uptime watch stops after the closing ceremony (6:00 PM PKT)
EVENT_ENDS_AT=2026-10-17T13:00:00Z

# Optional: deployment hostname allowlist regex (defaults to Alternate Clouds)
# DEPLOY_HOST_PATTERN=^[a-z0-9-]+-app\.alternatefutures\.ai$

# Email sent directly from the app (optional; n8n is used as fallback)
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional sender name; defaults to CoJudge plus SMTP_USER
# SMTP_FROM=CoJudge <you@gmail.com>
