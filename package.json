{
  "name": "cojudge",
  "version": "0.1.0",
  "private": true,
  "description": "AI does the checking, humans do the judging.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "pglite-server --db=./.pgdata --port=5433 --max-connections=40",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "hash-passcode": "tsx scripts/hash-passcode.ts",
    "set-passcode": "tsx scripts/set-passcode.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next": "15.5.28",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
