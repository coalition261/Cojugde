      "onError": "continueErrorOutput",
      "credentials": { "httpHeaderAuth": { "id": "rZFpG2m0mKZDSFXl", "name": "CoJudge Internal Key" } }
    }
  ],
  "connections": {
    "17 Oct 11:45 AM PKT": { "main": [[{ "node": "Fetch teams with open failed checks", "type": "main", "index": 0 }]] },
    "Fetch teams with open failed checks": { "main": [[{ "node": "Split Out emails", "type": "main", "index": 0 }], []] },
    "Split Out emails": { "main": [[{ "node": "Send reminder", "type": "main", "index": 0 }]] },
    "Send reminder": { "main": [[{ "node": "Log sent", "type": "main", "index": 0 }], []] }
